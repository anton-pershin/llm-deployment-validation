[MAIN]
ignore-paths=tests

[MESSAGES CONTROL]
disable=too-many-instance-attributes,
        too-many-arguments,
        too-many-positional-arguments,
        too-many-locals,
        too-many-branches,
        too-many-statements,
        broad-exception-caught,
        import-outside-toplevel,
        duplicate-code

[FORMAT]
max-line-length=100

[BASIC]
good-names=i,j,k,e,f,logger
